# Salin file ini menjadi ".env.local" (di folder yang sama) lalu isi nilainya.
# JANGAN commit file ".env.local" ke git — sudah otomatis diabaikan lewat .gitignore.
# Untuk deployment di Vercel, isi keempat nilai ini di:
# Project Settings -> Environment Variables (bukan lewat file ini).

# Email service account dari Google Cloud (akun "robot" yang diberi akses
# baca ke spreadsheet Anda). Contoh: paradigm-app@nama-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# Private key dari file JSON kredensial service account (bagian "private_key").
# Salin apa adanya termasuk "-----BEGIN PRIVATE KEY-----" dan "\n" di dalamnya,
# lalu bungkus dengan tanda kutip ganda seperti contoh ini:
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQ...\n-----END PRIVATE KEY-----\n"
GOOGLE_PRIVATE_KEY=

# ID spreadsheet Google Sheets Anda — bagian di URL antara "/d/" dan "/edit".
# Contoh URL: https://docs.google.com/spreadsheets/d/INI_ID_NYA/edit
GOOGLE_SHEET_ID=

# Teks acak & rahasia untuk menandatangani sesi login. Buat sendiri, minimal
# 32 karakter, jangan dipakai ulang dari proyek lain. Contoh membuatnya di
# terminal: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Opsional. Nama tab (sheet) tempat data pegawai/NIP/Password berada.
# Kosongkan untuk memakai default "Sheet1". Isi ini kalau tab Anda diberi
# nama lain (misal "Users" atau "Data Pegawai").
GOOGLE_SHEET_TAB=
