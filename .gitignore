# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# hasil tarikan data lokal (scripts/tarik-iku.mjs) — jangan ikut ter-commit,
# bisa berisi data pegawai mentah.
/scripts/output/

# File laporan/deliverable yang Claude kadang simpan di folder project ini
# (hasil export Claude Docs, file CSV/XLSX/DOCX/PDF yang dikirim lewat chat,
# dll) — BUKAN bagian dari kode aplikasi dan beberapa bisa berisi data
# pegawai mentah (mis. NIP, nilai kinerja). Jangan ikut ter-commit walau
# "git add -A" dipakai. Kalau memang butuh fixture/contoh data sungguhan,
# taruh di folder lain yang tidak kena pola di bawah.
/Claude outputs/
/*.xlsx
/*.docx
/*.pptx
/*.pdf
/*.csv

# typescript
*.tsbuildinfo
next-env.d.ts
